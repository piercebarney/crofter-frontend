{
	"name": "crofter",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev-lan": "npm run dev -- --host --port 3333",
		"dev-cf": "npx wrangler dev",
		"build": "vite build",
		"preview": "vite preview",
		"build-preview": "vite build && vite preview",
		"cp-sw": "rm -f static/*.js && cp .svelte-kit/output/client/*.js static/",
		"pub-dev": "npx vite build --mode dev && npm run cp-sw && npx wrangler deploy --env dev",
		"pub-staging": "npx vite build --mode staging && npm run cp-sw && npx wrangler deploy --env staging",
		"pub-prod": "npx vite build --mode prod && npm run cp-sw && npx wrangler deploy --env prod",
		"tail": "npx wrangler tail --format=pretty --env prod",
		"pub-tail": "npx wrangler deploy --env prod && npx wrangler tail --format=pretty --env prod",
		"check": "svelte-kit sync; npm run check:ts; npm run lint ",
		"check:ts": "svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"install-safe": "npm install --legacy-peer-deps",
		"update-safe": "npm update --legacy-peer-deps",
		"add-safe": "npm add --legacy-peer-deps",
		"lint": "npm run lint:js; npm run lint:css",
		"lint:js": "eslint .",
		"lint:css": "stylelint **/*.scss",
		"test": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20230307.0",
		"@eslint/js": "^9.39.2",
		"@internationalized/date": "^3.10.0",
		"@picocss/pico": "^2.0.6",
		"@stylistic/stylelint-plugin": "^4.0.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-cloudflare": "^4.9.0",
		"@sveltejs/adapter-cloudflare-workers": "^2.1.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24.5.1",
		"@types/serviceworker": "^0.0.121",
		"@types/tinymce": "^4.6.9",
		"@types/zipcodes": "^8.0.5",
		"@typescript-eslint/eslint-plugin": "^8.50.0",
		"@typescript-eslint/parser": "^8.50.0",
		"bits-ui": "^2.14.4",
		"canvas": "^3.1.0",
		"eslint": "^9.21.0",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"png-to-ico": "^2.1.8",
		"postcss-nested": "^7.0.2",
		"postcss-scss": "^4.0.9",
		"sass": "^1.69.5",
		"scss": "^0.2.4",
		"sharp": "^0.33.5",
		"stylelint": "^16.15.0",
		"stylelint-config-standard": "^37.0.0",
		"stylelint-config-standard-scss": "^16.0.0",
		"stylelint-scss": "^6.11.1",
		"svelte": "^5.22.1",
		"svelte-check": "^3.6.0",
		"svelte-preprocess": "^6.0.3",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.50.0",
		"vite": "^6.2.0",
		"vite-plugin-appsignal": "^0.8.0",
		"vite-plugin-chunk-split": "^0.5.0",
		"vitest": "^3.0.7",
		"wrangler": "^4.14.4"
	},
	"dependencies": {
		"@apollo/client": "^3.7.3",
		"@appsignal/javascript": "^1.3.28",
		"@appsignal/nodejs": "^3.7.3",
		"@appsignal/plugin-window-events": "^1.0.20",
		"@auth0/auth0-spa-js": "^2.3.0",
		"@capacitor/core": "^7.1.0",
		"@capacitor/splash-screen": "^7.0.0",
		"@capacitor/status-bar": "^7.0.0",
		"@preact/signals": "^2.1.1",
		"@rollup/plugin-graphql": "^2.0.2",
		"@rollup/plugin-replace": "^5.0.2",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/gestures": "^0.0.1",
		"@tsndr/cloudflare-worker-jwt": "^2.2.5",
		"@vite-pwa/sveltekit": "^0.6.7",
		"apollo-absinthe-upload-link": "^1.7.0",
		"clsx": "^2.1.1",
		"currency.js": "^2.0.4",
		"graphql": "^16.6.0",
		"lucide-svelte": "^0.555.0",
		"mode-watcher": "^1.1.0",
		"node-fetch": "^2.6.11",
		"preact": "^10.26.7",
		"tailwind-merge": "^3.4.0",
		"tinymce": "^6.8.1",
		"vite-plugin-pwa": "^0.21.1",
		"zipcodes": "^8.0.0"
	},
	"overrides": {
		"graphql": {
			"@rollup/plugin-graphql": "^2.0.2"
		},
		"apollo-absinthe-upload-link": {
			"rxjs": "7.8.0"
		}
	}
}
